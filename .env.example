# Vidar configuration. Copy to .env and fill in "The watched site".
# An unknown key stops the container from starting.

# ── Paths (inside the container) ─────────────────────────────────────────────
LOG_PATH=/logs/access.log
DB_PATH=/data/vidar.db
ARCHIVE_DIR=/data/archive
# Days a re-imported month stays active before it is archived again.
ARCHIVE_RESTORE_DAYS=7

# ── Backups ──────────────────────────────────────────────────────────────────
# Daily snapshot, same disk as the database. Copy it off the host yourself.
BACKUP_DIR=/data/backup
BACKUP_ENABLED=true
BACKUP_KEEP=7
# Deprecated, removed in 2.0. Deletes nothing; retention is set in the UI.
RETENTION_DAYS=90
# Days before an IP's geo and threat data is looked up again.
ENRICHMENT_CACHE_TTL_DAYS=30

# ── The watched site ─────────────────────────────────────────────────────────
# These three describe your website, not Vidar. They ship blank because no
# default fits someone else's site. Unset, nothing breaks — Vidar just has less
# to judge visitors by. The deploy refuses to ship without them.
#
# All three examples below describe one imaginary site, laid out like this:
#
#   https://your-site.example/
#   ├── index.html, about.html           the pages themselves
#   └── assets/
#       ├── css/main.css, img/logo.png   stylesheet, image
#       ├── js/main.js                   your own JavaScript
#       ├── lang/de.json                 translations, fetched by main.js
#       └── fragments/about.html         page bodies, fetched by main.js

# Your site's own address. When a request arrives with a referer starting here,
# the visitor came from one of your own pages — clicking through the site rather
# than landing on it from a search engine or someone else's link.
#   SITE_BASE_URL=https://your-site.example
SITE_BASE_URL=

# The URL prefix your own files are served from: stylesheets, images, language
# files. Requests for those are dropped instead of counted as visits.
#
# You have to say where, because .json is ambiguous. Above, /assets/lang/de.json
# is one of your pages loading a translation. /credentials.json would be somebody
# hunting for secrets. Below this prefix a .json is your own asset and gets
# dropped; anywhere else it is a request worth recording.
#   STATIC_ASSET_PREFIXES=/assets/
STATIC_ASSET_PREFIXES=

# Paths that only your own JavaScript ever requests — nobody types them, nothing
# links to them. So a client that fetched one must have run your JavaScript,
# which makes it a real browser and not a script. For older HTTP/1.1 clients,
# which send no Sec-Fetch headers, this is the only proof of a browser there is.
# Above, that is /assets/fragments/ — nothing links there, only main.js asks.
#   JS_ONLY_PATH_PREFIXES=/assets/fragments/
JS_ONLY_PATH_PREFIXES=

# ── Log ingestion ────────────────────────────────────────────────────────────
# Seconds between checks for new log lines.
POLL_INTERVAL_SECONDS=1.0
# First start only: false starts at the end of the log, true reads it all.
# True can double-count, because nginx timestamps resolve only to the second.
INGEST_EXISTING_BACKLOG=false

# ── Enrichment ───────────────────────────────────────────────────────────────
# IPs per ip-api.com request. Their free tier allows 100.
ENRICHMENT_BATCH_SIZE=100
# Shodan publishes no rate limit, so we set our own and back off on a 429.
SHODAN_REQUESTS_PER_MINUTE=600
SHODAN_COOLDOWN_SECONDS=300
# Requests in flight at once.
SHODAN_CONCURRENCY=10
DNSBL_CONCURRENCY=10
# Seconds to wait on a DNS lookup.
DNS_TIMEOUT_SECONDS=5.0
# Seconds the Tor exit list is reused before downloading it again.
TOR_CACHE_TTL_SECONDS=86400
# Queue between log reader and enricher. When full, an IP is picked up later.
ENRICHMENT_QUEUE_MAXSIZE=10000
# Minutes between classifier re-runs for IPs whose behaviour changed.
RECLASSIFY_INTERVAL_MINUTES=15

# ── DNSBL ────────────────────────────────────────────────────────────────────
DNSBL_ENABLED=true
DNSBL_PROVIDERS=zen.spamhaus.org,bl.spamcop.net
# Without a key, Spamhaus refuses queries from containers and reports
# "not listed" for everything. Free for non-commercial use:
#   https://www.spamhaus.com/data-access/free-data-query-service/
DNSBL_DQS_KEY=

# ── Filtering ────────────────────────────────────────────────────────────────
# Requests that never become a visit.
# Fill an empty database with synthetic traffic and serve that instead of
# reading a log. For trying the dashboard out; never points at a real log, and
# refuses to seed a database that already holds visits.
DEMO_MODE=false

FILTER_STATIC_ASSETS=true
FILTER_INTERNAL_IPS=true
# Extensions never counted as a visit. JSON, not comma-separated. These are
# filtered before classification, so bot detection never sees them.
# STATIC_EXTENSIONS=[".css",".js",".png",".jpg",".jpeg",".gif",".svg",".ico",".woff",".woff2",".ttf",".eot",".map",".json"]

# ── Map ─────────────────────────────────────────────────────────────────────
# Without a key, CARTO stamps "API KEY REQUIRED" across every basemap tile. The
# markers and the panels are unaffected; the background is unreadable. A wrong
# key looks exactly like no key, so if the watermark stays, check this first.
# Free for non-commercial use, emailed back without an account:
#   https://carto.com/basemaps/apikey
CARTO_API_KEY=

# ── Server location (optional) ───────────────────────────────────────────────
# Your server's marker on the map. Blank coordinates hide it.
SERVER_LAT=
SERVER_LON=
SERVER_CITY=
SERVER_COUNTRY=
SERVER_ASN=
SERVER_IP=

# ── SQLite ───────────────────────────────────────────────────────────────────
# Seconds a connection waits for a lock before giving up.
DB_CONNECTION_TIMEOUT=10

# ── Export rate limiting ─────────────────────────────────────────────────────
# Exports per window per IP, for /api/export.
EXPORT_RATE_LIMIT=5
EXPORT_RATE_LIMIT_WINDOW_S=3600
